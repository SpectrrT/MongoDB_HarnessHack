{
  "name": "offload",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offload: an agent harness that sleeps, and wakes up with a better harness",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "desktop:package": "npm run build && node scripts/stage-desktop.mjs && electron-builder --mac dir",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build",
    "rem:demo": "node scripts/rem-demo.mjs",
    "vendor:build": "node scripts/vendor.mjs",
    "desktop:setup": "npm install --no-save --package-lock=false electron@44.4.5 electron-builder@26 && node node_modules/electron/install.js",
    "harness:worker": "node --env-file-if-exists=.env server/harness/worker.js",
    "harness:server": "node --env-file-if-exists=.env server/index.js",
    "sleep:worker": "node --env-file-if-exists=.env server/sleep/worker.js",
    "local:https:prepare": "node scripts/local-https.mjs prepare",
    "local:https": "node scripts/local-https.mjs start",
    "local:https:stop": "node scripts/local-https.mjs stop",
    "local:https:status": "node scripts/local-https.mjs status",
    "activity:collector": "node --env-file-if-exists=.env server/activity/collector.js",
    "activity:seed": "node --env-file-if-exists=.env server/activity/seed.js"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "express": "^5.2.1",
    "glimm": "latest",
    "helmet": "^8.1.0",
    "iconoir-react": "latest",
    "liveline": "latest",
    "lucide-react": "^0.562.0",
    "mongodb": "^7.6.0",
    "motion": "^12.23.26",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.13.0",
    "thinking-orbs": "0.3.2",
    "three": "0.134.0",
    "vanta": "0.5.24",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@playwright/test": "latest",
    "@tailwindcss/vite": "^4.2.0",
    "@vitejs/plugin-react": "latest",
    "concurrently": "^9.2.1",
    "esbuild": "latest",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.2.0",
    "vite": "^8.3.1"
  },
  "build": {
    "appId": "app.offload.desktop",
    "productName": "Offload",
    "directories": {
      "output": "release",
      "app": "desktop"
    },
    "files": [
      "main.cjs",
      "dist/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dir",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Offload records audio only during a work session you start.",
        "NSScreenCaptureUsageDescription": "Offload shares only the screen or window you select for a work session."
      },
      "icon": "desktop/icon.icns"
    },
    "electronVersion": "44.4.5",
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false
  }
}
