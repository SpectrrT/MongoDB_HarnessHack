{
  "name": "offload",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offload local-first workflow companion",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "desktop:package": "npm run build && electron-builder --mac dir",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build",
    "vendor:build": "node scripts/vendor.mjs",
    "desktop:setup": "npm install --no-save electron@44.4.5 electron-builder@26"
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.13.0",
    "lucide-react": "^0.562.0",
    "thinking-orbs": "0.3.2",
    "vanta": "0.5.24",
    "three": "0.134.0",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "zod": "^4.2.1",
    "echarts": "^6.1.0",
    "motion": "^12.23.26",
    "glimm": "latest",
    "liveline": "latest",
    "iconoir-react": "latest"
  },
  "devDependencies": {
    "vite": "^8.3.1",
    "@vitejs/plugin-react": "latest",
    "@tailwindcss/vite": "^4.2.0",
    "tailwindcss": "^4.2.0",
    "concurrently": "^9.2.1",
    "esbuild": "latest",
    "@playwright/test": "latest",
    "@axe-core/playwright": "latest",
    "supertest": "^7.2.2"
  },
  "build": {
    "appId": "app.offload.desktop",
    "productName": "Offload",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dir",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Offload records audio only during a work session you start.",
        "NSScreenCaptureUsageDescription": "Offload shares only the screen or window you select for a work session."
      }
    }
  }
}
