# browser: isolated local workspace, supports static hosting. api: local Express persistence.
VITE_STORAGE_MODE=browser
PORT=5194
# OFFLOAD_DATA_DIR=/absolute/private/path

# Live harness only. Use the event-provided Atlas sandbox, never commit secrets.
# MONGODB_URI=mongodb+srv://...
MONGODB_DATABASE=offload_hackathon
# Claude's MongoDB MCP server (.mcp.json) reuses MONGODB_URI read-only; false lets it write.
# MDB_MCP_READ_ONLY=false
# OPENROUTER_API_KEY=
# OFFLOAD_MODEL=provider/model

# Sleep v2 (agentic memory). Voyage embeddings, 1024 dimensions.
# VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-4
# EMBEDDINGS_BASE_URL=https://api.voyageai.com/v1
# atlas uses $vectorSearch on the event sandbox. local is for tests only.
# SLEEP_VECTOR_MODE=atlas

# Atlas workspace storage; the harness uses MONGODB_DATABASE above.
MONGODB_DB=offload

# REM on Atlas. Search runs in Atlas unless REM_ATLAS_SEARCH=0. REM_VECTOR_MODE=explicit uses stored
# vectors instead of autoEmbed. REM_DB_NAME is the server's database; REM_DEMO_DB is the one
# rem-demo --atlas clears (never the same). REM_COMPLETION=jev gates run completion with Jev via OpenRouter.
# REM_DB_NAME=rem
# REM_DEMO_DB=rem_demo
# REM_ATLAS_SEARCH=1
# REM_VECTOR_MODE=auto
# REM_COMPLETION=stub
